{
  "commands" : [ {
    "applyConfigurationCommand" : {
      "config" : {
        "appId" : "com.example.example",
        "ext" : { },
        "properties" : { },
        "tags" : [ "passing" ]
      },
      "optional" : false
    }
  }, {
    "launchAppCommand" : {
      "appId" : "com.example.example",
      "optional" : false
    }
  }, {
    "assertConditionCommand" : {
      "condition" : {
        "visible" : {
          "optional" : false,
          "textRegex" : "0"
        }
      },
      "optional" : false
    }
  }, {
    "repeatCommand" : {
      "commands" : [ {
        "tapOnElement" : {
          "longPress" : false,
          "optional" : false,
          "retryIfNoChange" : false,
          "selector" : {
            "idRegex" : "fabAddIcon",
            "optional" : false
          },
          "waitUntilVisible" : false
        }
      } ],
      "optional" : false,
      "times" : "3"
    }
  }, {
    "assertConditionCommand" : {
      "condition" : {
        "visible" : {
          "optional" : false,
          "textRegex" : "3"
        }
      },
      "optional" : false
    }
  }, {
    "assertConditionCommand" : {
      "condition" : {
        "notVisible" : {
          "optional" : false,
          "textRegex" : "0"
        }
      },
      "optional" : false
    }
  }, {
    "evalScriptCommand" : {
      "optional" : false,
      "scriptString" : "${output.counter = 0}"
    }
  }, {
    "repeatCommand" : {
      "commands" : [ {
        "evalScriptCommand" : {
          "optional" : false,
          "scriptString" : "${output.counter = output.counter + 1}"
        }
      } ],
      "condition" : {
        "scriptCondition" : "${output.counter < 3}"
      },
      "optional" : false
    }
  } ]
}
