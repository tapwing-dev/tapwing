{
  "commands" : [ {
    "applyConfigurationCommand" : {
      "config" : {
        "appId" : "com.example.SimpleWebViewApp",
        "ext" : { },
        "properties" : { },
        "tags" : [ "passing", "ios" ]
      },
      "optional" : false
    }
  }, {
    "launchAppCommand" : {
      "appId" : "com.example.SimpleWebViewApp",
      "clearState" : true,
      "optional" : false
    }
  }, {
    "retryCommand" : {
      "commands" : [ {
        "tapOnElement" : {
          "longPress" : false,
          "optional" : false,
          "retryIfNoChange" : false,
          "selector" : {
            "optional" : false,
            "textRegex" : "Open Login Page"
          },
          "waitUntilVisible" : false
        }
      }, {
        "assertConditionCommand" : {
          "condition" : {
            "notVisible" : {
              "optional" : false,
              "textRegex" : "Open Login Page"
            }
          },
          "optional" : false
        }
      }, {
        "assertConditionCommand" : {
          "condition" : {
            "visible" : {
              "optional" : false,
              "textRegex" : "Login"
            }
          },
          "label" : "Wait for Login page to load",
          "optional" : false,
          "timeout" : "90000"
        }
      } ],
      "maxRetries" : "2",
      "optional" : false
    }
  }, {
    "assertConditionCommand" : {
      "condition" : {
        "visible" : {
          "optional" : false,
          "textRegex" : "Sign In"
        }
      },
      "optional" : false
    }
  }, {
    "assertConditionCommand" : {
      "condition" : {
        "visible" : {
          "optional" : false,
          "textRegex" : "Forgot your password?"
        }
      },
      "optional" : false
    }
  } ]
}
