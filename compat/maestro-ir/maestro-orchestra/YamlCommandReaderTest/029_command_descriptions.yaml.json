{
  "commands" : [ {
    "applyConfigurationCommand" : {
      "config" : {
        "appId" : "com.example.app",
        "ext" : { },
        "properties" : { },
        "tags" : [ ]
      },
      "optional" : false
    }
  }, {
    "tapOnElement" : {
      "label" : "Scroll to find the maybe-later button",
      "longPress" : false,
      "optional" : false,
      "retryIfNoChange" : false,
      "selector" : {
        "optional" : false,
        "textRegex" : "maybe-later"
      },
      "waitUntilVisible" : false
    }
  }, {
    "inputTextCommand" : {
      "optional" : false,
      "text" : "${username}"
    }
  }, {
    "assertConditionCommand" : {
      "condition" : {
        "visible" : {
          "optional" : false,
          "textRegex" : "Hello ${username}"
        }
      },
      "optional" : false
    }
  }, {
    "assertConditionCommand" : {
      "condition" : {
        "scriptCondition" : "${true}"
      },
      "label" : "${\"Check that\".concat(\" \", \"true is still true\")}",
      "optional" : false
    }
  } ]
}
